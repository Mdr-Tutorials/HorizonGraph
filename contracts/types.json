  "applicability_default": "optional",
  "ontology_node": {
    "note": "meta_concept 节点只存在于 contracts/ontology.json，实例列表由 build 派生",
    "shape": {
      "id": "required，slug；与数据节点共享 id 空间；根分类与锚点 slug 保留（见 conventions.md）",
      "name": "required",
      "aliases": "required，可为空数组",
      "summary": "required，中文 50 字以内",
      "parents": "数组，多亲 DAG——一个分类可属多个上级；锚点为空数组；生效 entity_type 为各 parent 链的并集",
      "relations": "required，可为空数组；与数据节点同一 RelationEdge 形状，锚点间元叙事为普通关系边",
      "entity_type": "类型根必填；超根声明数组；中间分类按需覆写；未声明时取各 parent 链生效集的并集",
      "importance": "optional，导航权重",
      "last_reviewed": "optional，本体整体带版本号"
    }
  },
  "cross_file_rules": [
    "relations[].relation_type 必须是 contracts/relations.json 的键",
    "关系表达全图统一为 relations 数组，不设 parents、worldview 等其他边载体",
    "ecosystems / domains / tags 取值必须命中 contracts/vocab/ 对应文件的 value",
    "ecosystems 注册表无环，所有链路终于宏观根；节点的宏观归属与祖先由 build 派生",
    "is_instance_of 的 target_id 必须存在于 ontology.json，且源节点 type 属于目标分类生效的 entity_type 集合",
    "数据平面文件被 is_instance_of / specializes 指向时 CI 失败",
    "id 跨全图唯一；name/abbreviation/aliases 允许同名，同名异物由检索层区分",
    "契约目录不含派生物"
  ]
}
