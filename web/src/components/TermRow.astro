---
const { id, primary, secondary, realm } = Astro.props as {
  id: string;
  primary: string;
  secondary?: string;
  realm?: string;
};
const B = import.meta.env.BASE_URL;
const TXT: Record<string, string> = {
  technical: "text-realm-tech",
  industrial: "text-realm-industry",
  conceptual: "text-realm-concept",
};
---
<a href={`${B}term/${id}`} class="inline-block w-fit py-1 hover:underline no-underline">
  <span class={`font-term font-semibold ${TXT[realm ?? "technical"] ?? TXT.technical}`}>{primary}</span>
  {secondary && <span class="font-term text-sm text-secondary-name">{secondary}</span>}
</a>