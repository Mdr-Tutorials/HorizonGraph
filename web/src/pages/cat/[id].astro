---
import Base from "../../layouts/Base.astro";
import TermRow from "../../components/TermRow.astro";
import { REALM_OF } from "../../generated/contracts.gen";
import { labelOf } from "../../lib/ui";
import { json } from "../../lib/server";

export function getStaticPaths() {
  return json("dist/site/taxonomy.json").map((t: any) => ({ params: { id: t.id } }));
}

const { id } = Astro.params;
const ids: string[] = json("dist/graph/ids.json");
const nodes: any[][] = json("dist/graph/nodes.json");
const taxonomy: any[] = json("dist/site/taxonomy.json");
const B = import.meta.env.BASE_URL;
const cat = taxonomy.find((t) => t.id === id);
const children = taxonomy.filter((t) => (t.parents ?? []).includes(id));
const instances = (cat?.instances ?? [])
  .map((i: number) => {
    const l = labelOf(nodes[i]?.[0] ?? "", nodes[i]?.[1], nodes[i]?.[10] ?? [], nodes[i]?.[12] ?? "", nodes[i]?.[13] ?? "", nodes[i]?.[2]);
    return {
      id: ids[i],
      primary: l.primary,
      secondary: l.secondary,
      realm: REALM_OF[nodes[i]?.[2]] ?? "technical",
      importance: nodes[i]?.[4] ?? 0,
    };
  })
  .sort((a: any, b: any) => b.importance - a.importance || (a.id < b.id ? -1 : 1));
---
<Base title={`${cat?.zh || cat?.name || id} · 分类 · HorizonGraph`}>
  <h1 class="text-2xl font-semibold flex items-baseline gap-3 flex-wrap">
    <span class="font-term text-realm-concept">{cat?.zh || cat?.name || id}</span>
    {cat?.zh && cat?.name && <span class="font-term text-base font-normal text-secondary-name">{cat.name}</span>}
  </h1>
  {cat?.summary && <p class="mt-4 leading-7 text-ink-2">{cat.summary}</p>}
  {(cat?.parents ?? []).length > 0 && (
    <section class="mt-8">
      <h2 class="text-sm font-semibold text-ink-2">
        父分类<span class="font-mono text-xs font-normal text-ink-3 ml-2">{(cat?.parents ?? []).length}</span>
      </h2>
      <ul class="mt-2">
        {cat!.parents.map((p: string) => {
          const pt = taxonomy.find((t: any) => t.id === p);
          return (
            <li>
              <a href={`${B}cat/${p}`} class="flex items-baseline gap-2 py-1 hover:underline no-underline">
                <span class="font-term font-semibold text-realm-concept">{pt?.zh ?? pt?.name ?? p}</span>
                {pt?.zh && pt?.name && <span class="font-term text-sm text-secondary-name">{pt.name}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
  {children.length > 0 && (
    <section class="mt-8">
      <h2 class="text-sm font-semibold text-ink-2">
        子分类<span class="font-mono text-xs font-normal text-ink-3 ml-2">{children.length}</span>
      </h2>
      <ul class="mt-2">
        {children.map((c: any) => (
          <li>
            <a href={`${B}cat/${c.id}`} class="flex items-baseline gap-2 py-1 hover:underline no-underline">
              <span class="font-term font-semibold text-realm-concept">{c.zh || c.name}</span>
              {c.zh && c.name && <span class="font-term text-sm text-secondary-name">{c.name}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
  {instances.length > 0 && (
    <section class="mt-8">
      <h2 class="text-sm font-semibold text-ink-2">
        实例<span class="font-mono text-xs font-normal text-ink-3 ml-2">{instances.length}</span>
      </h2>
      <ul class="mt-2">
        {instances.map((m: any) => (
          <li><TermRow {...m} /></li>
        ))}
      </ul>
    </section>
  )}
</Base>
